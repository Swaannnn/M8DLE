DATABASE_URL=
AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CRON_SECRET=
MAINTENANCE_MODE=false
# Optionnel : force le driver Prisma (neon | pg). Par défaut : neon si DATABASE_URL pointe vers *.neon.tech, sinon pg.
DATABASE_DRIVER=
# Docker / Coolify : mettre à true pour ne pas lancer `prisma migrate deploy` au démarrage du conteneur.
SKIP_MIGRATIONS=false
